            "rawdescription": "\n",
            "type": "component",
            "sourceCode": "import { Component, Input } from '@angular/core';\nimport { CommonModule } from '@angular/common';\n\n@Component({\n  selector: 'app-footer',\n  imports: [CommonModule],\n  templateUrl: './footer.html',\n})\nexport class Footer {\n  @Input() theme: 'light' | 'dark' | 'brand' = 'light';\n  @Input() variant: 'default' | 'compact' | 'horizontal' = 'default';\n}\n",
            "assetsDirs": [],
            "styleUrlsData": "",
            "stylesData": "",
            "extends": [],
            "templateData": "<footer [class.bg-gray-900]=\"theme === 'dark'\" [class.bg-white]=\"theme === 'light'\"\n    [class.bg-indigo-600]=\"theme === 'brand'\" [class.text-white]=\"theme === 'dark' || theme === 'brand'\"\n    [class.text-gray-900]=\"theme === 'light'\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12\">\n        @if (variant === 'default' || variant === 'horizontal') {\n        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n            <div>\n                <h3 class=\"text-lg font-semibold mb-4\">Company</h3>\n                <ul class=\"space-y-2\">\n                    <li><a href=\"#\" class=\"hover:underline\">About</a></li>\n                    <li><a href=\"#\" class=\"hover:underline\">Careers</a></li>\n                    <li><a href=\"#\" class=\"hover:underline\">Press</a></li>\n                </ul>\n            </div>\n            <div>\n                <h3 class=\"text-lg font-semibold mb-4\">Support</h3>\n                <ul class=\"space-y-2\">\n                    <li><a href=\"#\" class=\"hover:underline\">Help Center</a></li>\n                    <li><a href=\"#\" class=\"hover:underline\">Contact Us</a></li>\n                    <li><a href=\"#\" class=\"hover:underline\">FAQ</a></li>\n                </ul>\n            </div>\n            <div>\n                <h3 class=\"text-lg font-semibold mb-4\">Legal</h3>\n                <ul class=\"space-y-2\">\n                    <li><a href=\"#\" class=\"hover:underline\">Privacy Policy</a></li>\n                    <li><a href=\"#\" class=\"hover:underline\">Terms of Service</a></li>\n                </ul>\n            </div>\n        </div>\n        }\n\n        @if (variant === 'compact') {\n        <div class=\"grid grid-cols-2 md:grid-cols-4 gap-6\">\n            <div>\n                <h3 class=\"text-base font-semibold mb-2\">Company</h3>\n                <ul class=\"space-y-1 text-sm\">\n                    <li><a href=\"#\" class=\"hover:underline\">About</a></li>\n                    <li><a href=\"#\" class=\"hover:underline\">Careers</a></li>\n                </ul>\n            </div>\n            <div>\n                <h3 class=\"text-base font-semibold mb-2\">Support</h3>\n                <ul class=\"space-y-1 text-sm\">\n                    <li><a href=\"#\" class=\"hover:underline\">Help Center</a></li>\n                    <li><a href=\"#\" class=\"hover:underline\">Contact</a></li>\n                </ul>\n            </div>\n            <div>\n                <h3 class=\"text-base font-semibold mb-2\">Legal</h3>\n                <ul class=\"space-y-1 text-sm\">\n                    <li><a href=\"#\" class=\"hover:underline\">Privacy</a></li>\n                    <li><a href=\"#\" class=\"hover:underline\">Terms</a></li>\n                </ul>\n            </div>\n            <div>\n                <h3 class=\"text-base font-semibold mb-2\">Connect</h3>\n                <div class=\"flex space-x-4 mt-2\">\n                    <a href=\"#\" class=\"hover:text-indigo-400\">🐦</a>\n                    <a href=\"#\" class=\"hover:text-indigo-400\">📘</a>\n                    <a href=\"#\" class=\"hover:text-indigo-400\">💼</a>\n                </div>\n            </div>\n        </div>\n        }\n\n        @if (variant === 'horizontal') {\n        <div class=\"flex flex-col md:flex-row justify-between items-center mt-12 pt-8 border-t border-white/10\">\n            <div class=\"text-sm\">\n                &copy; 2024 Your Company, Inc. All rights reserved.\n            </div>\n            <div class=\"flex space-x-6 mt-6 md:mt-0\">\n                <a href=\"#\" class=\"text-sm hover:underline\">Privacy</a>\n                <a href=\"#\" class=\"text-sm hover:underline\">Terms</a>\n                <a href=\"#\" class=\"text-sm hover:underline\">Contact</a>\n            </div>\n        </div>\n        }\n\n        @if (variant === 'default') {\n        <div class=\"mt-12 pt-8 border-t border-white/10 text-center\">\n            <p class=\"text-sm\">&copy; 2024 Your Company, Inc. All rights reserved.</p>\n        </div>\n        }\n    </div>\n</footer>"
