            "type": "component",
            "sourceCode": "import { Component, Input } from '@angular/core';\nimport { CommonModule } from '@angular/common';\n\n@Component({\n  selector: 'app-image-card',\n  imports: [CommonModule],\n  templateUrl: './image-card.html',\n})\nexport class ImageCard {\n  @Input() imageUrl: string = 'https://placehold.co/600x400';\n  @Input() imageAlt: string = 'Placeholder image';\n  @Input() title: string = 'Card Title';\n  @Input() description: string = 'This is a description of the card. It contains some text.';\n  @Input() badgeText?: string;\n  @Input() variant: 'default' | 'compact' | 'horizontal' = 'default';\n  @Input() theme: 'light' | 'dark' | 'brand' = 'light';\n}\n",
            "assetsDirs": [],
            "styleUrlsData": "",
            "stylesData": "",
            "extends": [],
            "templateData": "<div\n  [ngClass]=\"{\n    'flex flex-col': variant !== 'horizontal',\n    'flex flex-row items-center': variant === 'horizontal',\n    'max-w-sm': variant !== 'horizontal',\n    'max-w-2xl': variant === 'horizontal',\n    'bg-white text-slate-800': theme === 'light',\n    'bg-slate-800 text-white': theme === 'dark',\n    'bg-indigo-600 text-white': theme === 'brand',\n    'rounded-2xl shadow-lg overflow-hidden transition-transform duration-300 hover:-translate-y-1 hover:shadow-xl': true\n  }\"\n>\n  <div\n    class=\"relative\"\n    [ngClass]=\"{\n      'w-full': variant !== 'horizontal',\n      'w-1/3 shrink-0': variant === 'horizontal',\n      'h-48': variant === 'default',\n      'h-32': variant === 'compact',\n      'h-full': variant === 'horizontal'\n    }\"\n  >\n    <img\n      [src]=\"imageUrl\"\n      [alt]=\"imageAlt\"\n      class=\"w-full h-full object-cover\"\n    />\n    <div *ngIf=\"badgeText\" class=\"absolute top-3 right-3 bg-white/90 text-slate-800 text-xs font-bold px-2 py-1 rounded-full shadow-sm backdrop-blur-sm\">\n      {{ badgeText }}\n    </div>\n  </div>\n\n  <div\n    class=\"flex flex-col\"\n    [ngClass]=\"{\n      'p-6': variant === 'default' || variant === 'horizontal',\n      'p-4': variant === 'compact'\n    }\"\n  >\n    <h3\n      class=\"font-bold mb-2\"\n      [ngClass]=\"{\n        'text-xl': variant !== 'compact',\n        'text-lg': variant === 'compact'\n      }\"\n    >\n      {{ title }}\n    </h3>\n    <p\n      class=\"opacity-80\"\n      [ngClass]=\"{\n        'text-base': variant !== 'compact',\n        'text-sm': variant === 'compact'\n      }\"\n    >\n      {{ description }}\n    </p>\n  </div>\n</div>\n"
